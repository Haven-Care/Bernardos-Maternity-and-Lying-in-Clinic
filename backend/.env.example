PORT=6101
NODE_ENV=development
CORS_ORIGIN=http://localhost:6100

# Local Supabase by default (`npm run db:start` at the repo root).
# `npm run db:status` prints the local SERVICE_ROLE_KEY to paste below.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# Hosted staging (shared demonstration data, never production). Use these
# only for the hosted-development guide in docs/LOCAL_DEVELOPMENT.md.
# SUPABASE_URL=https://camqzzctawwqlwmqqpop.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
#
# The staging secret key comes privately from a maintainer. The variable name
# accepts a modern sb_secret_ key or a legacy service_role key. Both bypass RLS:
# server-side only, never commit the value, never put it in a VITE_ variable.
#
# Production keys live only in the Vercel Production environment. They are
# never copied into a developer's .env; see docs/PRODUCTION_CONFIG.md.

# Shared rate-limit counters (Upstash Redis, REST API). Leave both unset
# locally: limits then count in memory, which is fine for one process. Set both
# on Vercel, where each serverless instance would otherwise count on its own.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
