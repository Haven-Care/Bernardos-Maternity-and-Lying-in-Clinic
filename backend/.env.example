PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Local development
# ----------------
# Start the stack from the repo root, then read the values it prints:
#
#   npm run db:start
#   npm run db:status
#
# SUPABASE_URL is the "API URL" (http://127.0.0.1:54321) and the key below is
# the "service_role key". The CLI generates them per project — do not copy keys
# from another checkout or from the docs.
#
# Hosted (later): Project Settings > API in the Supabase dashboard.

SUPABASE_URL=
# service_role bypasses RLS and every authorization check in the database.
# Server-side only. It must never reach the browser, a client bundle, or a log.
SUPABASE_SERVICE_ROLE_KEY=
