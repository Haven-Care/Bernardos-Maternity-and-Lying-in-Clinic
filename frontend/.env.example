# Optional frontend dev-server port. Keep backend CORS_ORIGIN in sync.
PORT=6100

# Enable after configuring Google's authorized JavaScript origins and Supabase provider.
VITE_GOOGLE_LOGIN_ENABLED=false
# Public Web OAuth client ID (not the client secret). Must match Supabase's Google provider.
VITE_GOOGLE_CLIENT_ID=619815113208-dr02v4db3ifrp2ql0mgct36si6u4hthq.apps.googleusercontent.com

VITE_API_URL=http://localhost:6101/api

# Hosted Supabase. The project URL and publishable key are public values.
# VITE_SUPABASE_ANON_KEY is the existing variable name; it accepts a modern
# publishable key. Access depends on authentication and database RLS policies.
#
# The service_role key must NEVER appear in this file or any VITE_ variable.
# Anything prefixed VITE_ is compiled into the JavaScript the browser downloads.
VITE_SUPABASE_URL=https://camqzzctawwqlwmqqpop.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_rvTzVkKc0fBtHovMMuL4Ng_QmvdR0Wd
