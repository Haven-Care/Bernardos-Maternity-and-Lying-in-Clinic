VITE_API_URL=http://localhost:4000/api

# Local Supabase (npm run db:start at the repo root, then npm run db:status).
#
# The anon key is a publishable key — it is meant to ship in the client bundle.
# It grants nothing on its own: every table has RLS enabled with no policies, so
# this key cannot read or write one. Authentication is all it is for.
#
# The service_role key must NEVER appear in this file or any VITE_ variable.
# Anything prefixed VITE_ is compiled into the JavaScript the browser downloads.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
